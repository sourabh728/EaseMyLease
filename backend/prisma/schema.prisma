generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  STAFF
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  ON_RENT
  RETURNED
  UNDER_INSPECTION
  DAMAGED
  LOST
  UNDER_REPAIR
  RETIRED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  shops           Shop[]
  categories      Category[]
  inventoryItems  InventoryItem[]
  inventoryImages InventoryImage[]
  customers       Customer[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@index([tenantId])
  @@index([tenantId, role])
}

model Shop {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  logo              String?
  ownerName         String?
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstNumber         String?
  businessHours     Json?
  rentalTerms       String?  @db.Text
  defaultDeposit    Decimal? @db.Decimal(12, 2)
  defaultLateCharge Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]     @relation("CategoryHierarchy")
  items    InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

model InventoryItem {
  id              String          @id @default(cuid())
  tenantId        String
  categoryId      String
  itemCode        String
  name            String
  description     String?
  size            String?
  color           String?
  brand           String?
  purchasePrice   Decimal?        @db.Decimal(12, 2)
  rentalPrice     Decimal         @db.Decimal(12, 2)
  securityDeposit Decimal?        @db.Decimal(12, 2)
  condition       String?
  status          InventoryStatus @default(AVAILABLE)
  location        String?
  occasion        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   InventoryImage[]

  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([tenantId, itemCode])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, size])
  @@index([tenantId, color])
  @@index([tenantId, occasion])
}

model InventoryImage {
  id              String   @id @default(cuid())
  tenantId        String
  inventoryItemId String
  url             String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, inventoryItemId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  phone         String
  whatsapp      String?
  email         String?
  address       String?
  city          String?
  idProofType   String?
  idProofNumber String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, name])
}
