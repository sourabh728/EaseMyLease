generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SHOP_OWNER
  STAFF
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  ON_RENT
  RETURNED
  UNDER_INSPECTION
  DAMAGED
  LOST
  UNDER_REPAIR
  RETIRED
}

enum RentalStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  RETURN_PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}

enum ReturnCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  MISSING_ACCESSORY
  LOST
}

enum PaymentType {
  RENT
  DEPOSIT
  LATE_FEE
  DAMAGE_CHARGE
  REFUND
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum DamageSettlementStatus {
  OPEN
  SETTLED
  WAIVED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationType {
  RENTAL_DUE_TODAY
  RENTAL_OVERDUE
  RENTAL_RECEIPT
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Tenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  plan             SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  users            User[]
  shops            Shop[]
  categories       Category[]
  inventoryItems   InventoryItem[]
  inventoryImages  InventoryImage[]
  customers        Customer[]
  rentals          Rental[]
  rentalItems      RentalItem[]
  rentalReturns    RentalReturn[]
  damageRecords    DamageRecord[]
  payments         Payment[]
  notificationLogs NotificationLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String
  phone        String?
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email])
  @@index([tenantId])
  @@index([tenantId, role])
}

model Shop {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  logo              String?
  ownerName         String?
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  gstNumber         String?
  businessHours     Json?
  rentalTerms       String?  @db.Text
  defaultDeposit    Decimal? @db.Decimal(12, 2)
  defaultLateCharge Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems   InventoryItem[]
  customers        Customer[]
  rentals          Rental[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]     @relation("CategoryHierarchy")
  items    InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
}

model InventoryItem {
  id              String          @id @default(cuid())
  tenantId        String
  shopId          String?
  categoryId      String
  itemCode        String
  name            String
  description     String?
  size            String?
  color           String?
  brand           String?
  purchasePrice   Decimal?        @db.Decimal(12, 2)
  rentalPrice     Decimal         @db.Decimal(12, 2)
  securityDeposit Decimal?        @db.Decimal(12, 2)
  condition       String?
  status          InventoryStatus @default(AVAILABLE)
  location        String?
  occasion        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop          Shop?           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        InventoryImage[]
  rentalItems   RentalItem[]
  damageRecords DamageRecord[]

  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([tenantId, itemCode])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, shopId])
  @@index([tenantId, size])
  @@index([tenantId, color])
  @@index([tenantId, occasion])
}

model InventoryImage {
  id              String   @id @default(cuid())
  tenantId        String
  inventoryItemId String
  url             String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([tenantId, inventoryItemId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  shopId        String?
  name          String
  phone         String
  whatsapp      String?
  email         String?
  address       String?
  city          String?
  idProofType   String?
  idProofNumber String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop    Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  rentals Rental[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, shopId])
  @@index([tenantId, name])
}

model Rental {
  id                 String       @id @default(cuid())
  tenantId           String
  shopId             String?
  customerId         String
  rentalNumber       String
  rentalStartDate    DateTime
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  subtotal           Decimal      @db.Decimal(12, 2)
  discount           Decimal      @default(0) @db.Decimal(12, 2)
  totalRent          Decimal      @db.Decimal(12, 2)
  totalDeposit       Decimal      @db.Decimal(12, 2)
  amountPaid         Decimal      @default(0) @db.Decimal(12, 2)
  balanceAmount      Decimal      @db.Decimal(12, 2)
  status             RentalStatus @default(DRAFT)
  notes              String?      @db.Text
  createdBy          String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shop             Shop?             @relation(fields: [shopId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            RentalItem[]
  returns          RentalReturn[]
  damageRecords    DamageRecord[]
  payments         Payment[]
  notificationLogs NotificationLog[]

  @@unique([tenantId, rentalNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, shopId])
  @@index([tenantId, rentalStartDate])
  @@index([tenantId, expectedReturnDate])
  @@index([status])
}

model NotificationLog {
  id          String                      @id @default(cuid())
  tenantId    String
  type        NotificationType
  channel     NotificationChannel
  recipient   String
  rentalId    String?
  status      NotificationDeliveryStatus  @default(SENT)
  dayKey      String
  errorMessage String?
  payload     Json?
  createdAt   DateTime                    @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental Rental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, rentalId, type, channel, dayKey])
  @@index([tenantId])
  @@index([tenantId, type, dayKey])
  @@index([rentalId])
}

model RentalItem {
  id                 String  @id @default(cuid())
  tenantId           String
  rentalId           String
  inventoryItemId    String
  rentalPrice        Decimal @db.Decimal(12, 2)
  deposit            Decimal @default(0) @db.Decimal(12, 2)
  conditionAtRelease String?
  conditionAtReturn  String?
  notes              String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  damageRecords DamageRecord[]

  @@index([tenantId])
  @@index([rentalId])
  @@index([inventoryItemId])
  @@index([tenantId, inventoryItemId])
  @@unique([rentalId, inventoryItemId])
}

model RentalReturn {
  id           String   @id @default(cuid())
  tenantId     String
  rentalId     String
  returnDate   DateTime @default(now())
  lateFee      Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?  @db.Text
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental              @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  items         RentalReturnItem[]
  damageRecords DamageRecord[]

  @@index([tenantId])
  @@index([rentalId])
  @@index([tenantId, returnDate])
}

model RentalReturnItem {
  id                 String          @id @default(cuid())
  tenantId           String
  returnId           String
  rentalItemId       String
  inventoryItemId    String
  condition          ReturnCondition
  damageNotes        String?         @db.Text
  missingAccessories String?
  stains             Boolean         @default(false)
  isLost             Boolean         @default(false)
  additionalCharge   Decimal         @default(0) @db.Decimal(12, 2)
  notes              String?         @db.Text
  photoUrls          Json?

  return RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([rentalItemId])
  @@index([inventoryItemId])
}

model DamageRecord {
  id               String                  @id @default(cuid())
  tenantId         String
  rentalId         String
  returnId         String?
  rentalItemId     String?
  inventoryItemId  String
  description      String                  @db.Text
  chargeAmount     Decimal                 @default(0) @db.Decimal(12, 2)
  settlementStatus DamageSettlementStatus  @default(OPEN)
  settledAt        DateTime?
  photoUrls        Json?
  createdBy        String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental        Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  return        RentalReturn?  @relation(fields: [returnId], references: [id], onDelete: SetNull)
  rentalItem    RentalItem?    @relation(fields: [rentalItemId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([rentalId])
  @@index([returnId])
  @@index([inventoryItemId])
  @@index([tenantId, rentalId])
  @@index([tenantId, settlementStatus])
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  rentalId       String
  amount         Decimal       @db.Decimal(12, 2)
  paymentType    PaymentType
  method         PaymentMethod
  transactionRef String?
  paymentDate    DateTime      @default(now())
  notes          String?       @db.Text
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rentalId])
  @@index([tenantId, paymentDate])
  @@index([tenantId, paymentType])
}
