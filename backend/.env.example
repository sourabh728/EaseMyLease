# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easemylease?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/easemylease?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Supabase (storage / future use — not required for Phase 1 auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
