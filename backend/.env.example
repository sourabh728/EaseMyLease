# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easemylease?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/easemylease?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Email OTP (Nodemailer SMTP). If unset in development, OTP is logged to the server console.
# Gmail: use an App Password. Resend/others: use their SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EaseMyLease <noreply@example.com>"

# Phase 5: daily rental due/overdue email reminders (Cron 08:00). Set false to disable.
ENABLE_RENTAL_REMINDERS=true

# Supabase (storage / future use — not required for Nest JWT auth)
# SUPABASE_URL: project URL from Supabase dashboard
# SUPABASE_SERVICE_ROLE_KEY: server-only secret (never expose to frontend)
# SUPABASE_STORAGE_BUCKET: bucket name when using Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
